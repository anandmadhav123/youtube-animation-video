# Google Flow & YouTube Automation Configuration

# Gemini API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Flow Project URL
FLOW_PROJECT_URL=https://flow.google.com/project/0ebc25ad-8226-4302-a20a-f0728d85d0a2

# Chrome Remote Debugging Port
CHROME_CDP_PORT=9222

# Video Generation Settings
SCENE_DURATION_SECONDS=8
TOTAL_VIDEO_TARGET_MINUTES=2.5

# YouTube Settings (Path to client_secret.json downloaded from Google Cloud Console)
YOUTUBE_CLIENT_SECRET_FILE=client_secret.json
YOUTUBE_PRIVACY_STATUS=private
